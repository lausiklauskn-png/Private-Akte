{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Private Akte Pro",
  "mainBinaryName": "private-akte-pro",
  "version": "0.9.3",
  "identifier": "de.familyprojekt.privateakte",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node tools/build-web.mjs"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Family-Projekt",
    "category": "Productivity",
    "shortDescription": "Private Akte – Unterlagen, Kalender, Portemonnaie, offline",
    "resources": {
      "../runtime/": "runtime/"
    },
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German",
          "English"
        ]
      }
    }
  }
}
